class Solution:
    def moveZeroes(self, nums: List[int]) -> None:
        """
        Do not return anything, modify nums in-place instead.
        """
        if len(nums)==nums.count(0):
            return nums
        tmp=nums.count(0)
        if (tmp!=0):
            for i in range(tmp):
                nums.remove(0)

        for i in range(tmp):
            nums.append(0)
        return nums

        