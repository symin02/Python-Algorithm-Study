#방향을 반대로 해서 0에서 출발하여 모든 노드에 도달하면 그 반대 방향이 조건에 성립한다.
class Solution:
    def minReorder(self, n: int, connections: List[List[int]]) -> int:
        graph=[[] for _ in range(n)]
        graphs=[[] for _ in range(n)]
        for i in connections:
            graph[i[0]].append(i[1])
            graph[i[1]].append(i[0])
            graphs[i[0]].append(i[1])

        reverse=0
        stack=[0]
        v=[0]*n
        while(stack!=[]):
            now=stack.pop()

            if v[now]==0:
                v[now]=1
                for i in graph[now]:
                    stack.append(i)
                    if i in graphs[now] and v[i]==0:
                        # print(v,i,now)
                        reverse+=1



        return reverse