class Solution:
    def pairSum(self, head: Optional[ListNode]) -> int:
        now=head
        n=0
        tmp=[]
        while (now!=None):
            tmp.append(now.val)
            now=now.next
            n+=1
        j=0
        for i in range(n-1,n//2-1,-1):
            print(i,j)
            tmp[j]+=tmp[i]
            j+=1
 
        return max(tmp)


