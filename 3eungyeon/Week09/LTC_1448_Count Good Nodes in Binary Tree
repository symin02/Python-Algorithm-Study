class Solution:
    def goodNodes(self, root: TreeNode) -> int:
        n=0
        result=[]

   
        def whoismax(root):
            nonlocal n
            nonlocal result


            if root is None:
                return n

            result.append(root.val)

            if max(result)==result[-1]:
                # print(result,root.val)
                n+=1
                
            whoismax(root.left)
            whoismax(root.right)
            result.pop()
            # print("last",result,n)
            return n
        
        return whoismax(root)
        

